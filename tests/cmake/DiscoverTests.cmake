#
# Generates a CTest include file from the test binary's own registry
# (`--list-tests`). Runs as a build step, so adding a scenario never
# requires touching CMake: drop the .cpp, rebuild, ctest sees it.
#
# Required -D args:
#   TEST_EXECUTABLE  path to the test host binary
#   TEST_OUTPUT      file to (re)generate (a CTest TEST_INCLUDE_FILES entry)
#   TEST_GAMEDIR     staging root that holds cstrike/dlls/...
#   TEST_CSSUFFIX    staged game dll file name (e.g. cs_amd64.so)
#   TEST_WINDOWS     ON/OFF (selects the per-test home env var)

if(NOT DEFINED TEST_EXECUTABLE OR NOT DEFINED TEST_OUTPUT OR NOT DEFINED TEST_GAMEDIR OR NOT DEFINED TEST_CSSUFFIX)
    message(FATAL_ERROR "DiscoverTests.cmake: TEST_EXECUTABLE, TEST_OUTPUT, TEST_GAMEDIR and TEST_CSSUFFIX are required")
endif()

if(TEST_WINDOWS)
    set(_home "USERPROFILE")
else()
    set(_home "HOME")
endif()

file(WRITE "${TEST_OUTPUT}" "# generated by DiscoverTests.cmake; do not edit\n")

execute_process(
    COMMAND "${TEST_EXECUTABLE}" --list-tests
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _listed
    ERROR_QUIET
)

if(NOT _result EQUAL 0)
    message(WARNING "DiscoverTests.cmake: '${TEST_EXECUTABLE} --list-tests' failed (${_result})")
    return()
endif()

string(REPLACE "\r\n" "\n" _listed "${_listed}")
string(REPLACE "\n" ";" _names "${_listed}")

foreach(_name IN LISTS _names)
    string(STRIP "${_name}" _name)

    if(_name STREQUAL "")
        continue()
    endif()

    # non-default gamedir staging is a bracket tag on the case name
    set(_basedir "${TEST_GAMEDIR}")

    if(_name MATCHES "\\[regame\\]")
        set(_basedir "${TEST_GAMEDIR}-regame")
    elseif(_name MATCHES "\\[modern\\]")
        set(_basedir "${TEST_GAMEDIR}-modern")
    endif()

    string(TOLOWER "${_name}" _lower)
    string(REGEX REPLACE "[^a-z0-9]+" "_" _id "${_lower}")
    string(REGEX REPLACE "^_+" "" _id "${_id}")
    string(REGEX REPLACE "_+$" "" _id "${_id}")

    # private scratch dir per case: fixtures and saves are CWD-relative,
    # so a shared gamedir races under ctest -j and leaks between runs
    set(_workdir "${_basedir}/work/${_id}")
    file(MAKE_DIRECTORY "${_workdir}/cstrike/dlls")

    # mirror the staged game dll, the prod loader resolves it relative to CWD
    file(REMOVE "${_workdir}/cstrike/dlls/${TEST_CSSUFFIX}")
    file(CREATE_LINK "${_basedir}/cstrike/dlls/${TEST_CSSUFFIX}" "${_workdir}/cstrike/dlls/${TEST_CSSUFFIX}" RESULT _link_result SYMBOLIC COPY_ON_ERROR)

    if(NOT _link_result EQUAL 0)
        message(WARNING "DiscoverTests.cmake: cannot mirror game dll for '${_name}' (${_link_result})")
    endif()

    set(_case_env "YB_SINGLE_THREADED=1;${_home}=${_workdir}/home;YAPB_TEST_WORKDIR=${_workdir}")

    # ctest include files use the positional add_test form (not NAME/COMMAND)
    file(APPEND "${TEST_OUTPUT}"
        "add_test(yapb_${_id} \"${TEST_EXECUTABLE}\" \"--filter=${_name}\")\n"
        "set_tests_properties(yapb_${_id} PROPERTIES TIMEOUT 300 WORKING_DIRECTORY \"${_workdir}\" ENVIRONMENT \"${_case_env}\")\n"
    )
endforeach()
